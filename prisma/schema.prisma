// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  student
  professor
  professional
}

enum PortfolioStatus {
  generating
  draft
  published
  failed
}

model User {
  id                  Int         @id @default(autoincrement())
  email               String      @unique
  name                String
  password            String
  role                String?
  phone               String?
  github              String?
  company             String?
  jobTitle            String?
  tel                 String?
  university          String?
  department          String?
  major               String?
  organizationAddress String?
  onboardingCompleted Boolean     @default(false)
  portfolios          Portfolio[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Portfolio {
  id              Int              @id @default(autoincrement())
  userId          Int
  title           String
  userType        UserType
  cardDesignId    String
  siteDesignId    String
  card            Json
  profile         Json
  blocks          Json
  aiMeta          Json?
  aiWarnings      Json?
  sourceLinks     Json
  sourceSnapshots Json
  schemaVersion   Int              @default(1)
  status          PortfolioStatus  @default(draft)
  user            User             @relation(fields: [userId], references: [id])
  shares          PortfolioShare[]
  attachments     PortfolioAttachment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model PortfolioAttachment {
  id           Int       @id @default(autoincrement())
  portfolioId  Int
  s3Key        String
  originalName String
  mimeType     String
  size         Int
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([portfolioId])
}

model PortfolioShare {
  id          Int       @id @default(autoincrement())
  portfolioId Int
  shareId     String    @unique
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}
